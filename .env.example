# Copy to .env.local for local development. Never commit real values.
# Every variable is described in SETUP.md › Environment variables.

# --- Phase 0 ---
# Supabase transaction pooler string (port 6543); used only by the website (SETUP.md §2)
DATABASE_URL=
# Supabase session pooler string (port 5432); used by the pipeline and migrations (SETUP.md §2)
SESSION_DATABASE_URL=
# Fine-grained GitHub token (Actions read and write); GitHub secret copied to the Worker, never read by app code (SETUP.md §6)
GH_DISPATCH_TOKEN=
# Cloudflare "Edit Cloudflare Workers" token; used only by the deploy-worker workflow (SETUP.md §5)
CLOUDFLARE_API_TOKEN=
# Cloudflare account ID; used only by the deploy-worker workflow (SETUP.md §5)
CLOUDFLARE_ACCOUNT_ID=
# Optional comma-separated source ids to skip, for example tiktok,twitch
DISABLED_SOURCES=

# --- Phase 1 ---
# The site's production domain, for the pipeline's revalidation call (SETUP.md §7)
SITE_URL=
# Random string of 32+ characters, same value on Vercel and in GitHub (SETUP.md §8)
REVALIDATE_SECRET=
# User-Agent for collector requests, for example top10-trends/0.1 (+https://top10-trends.vercel.app)
COLLECTOR_USER_AGENT=
# YouTube Data API v3 key (SETUP.md §3)
YOUTUBE_API_KEY=
# Twitch app credentials (SETUP.md §4)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional Mastodon server host; defaults to mastodon.social
MASTODON_INSTANCE=

# --- Phase 2 ---
# Only if you chose OpenAI embeddings (SETUP.md §13)
OPENAI_API_KEY=

# --- Phase 3 ---
# X app Bearer token (SETUP.md §10)
X_BEARER_TOKEN=
# Reddit app credentials, once approved (SETUP.md §9)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Your Reddit username, for Reddit's required User-Agent (SETUP.md §9)
REDDIT_USERNAME=
# Pinterest access token (SETUP.md §11)
PINTEREST_ACCESS_TOKEN=
# Apify API token, for TikTok and Instagram (SETUP.md §12)
APIFY_TOKEN=
# Set to true to turn TikTok on (SETUP.md §12)
TIKTOK_ENABLED=
# Set to true to turn Instagram on (SETUP.md §12)
INSTAGRAM_ENABLED=
# Anthropic API key, for Claude topic names (SETUP.md §13)
ANTHROPIC_API_KEY=
